# SAIL 环境变量示例。复制为 .env 并修改。

# 基础设施
# 本地开发可不设此项——默认 SQLite（./sail.db），无需 MySQL/Redis。
# 生产用 MySQL：mysql+pymysql://sail:sail@localhost:3306/sail
# SAIL_MYSQL_URL=mysql+pymysql://sail:sail@localhost:3306/sail
SAIL_REDIS_URL=redis://localhost:6379/0
SAIL_MINIO_ENDPOINT=localhost:9000
SAIL_MINIO_ACCESS_KEY=sail
SAIL_MINIO_SECRET_KEY=sail123456
SAIL_MINIO_BUCKET=sail

# CodeQL
# 留 codeql 时：若 PATH 无 codeql，BUILD 阶段降级为 NO_BUILD，
# 扫描走内置 Tree-sitter 污点分析（scanner_id=sail-taint），仍产出真实 source→sink 候选。
# 装 CodeQL CLI 后设绝对路径，启用真 CodeQL 扫描。
SAIL_CODEQL_CLI_PATH=codeql
SAIL_WORKSPACE_ROOT=/tmp/sail-workspaces

# LLM
# API key 留空时：AI_ANALYZE 阶段走规则启发式兜底（model_name=sail-heuristic-v1），
# 仍产出结构化 AiReview（verdict/confidence/remediation），明确标注非 LLM。
# 配置 key 后自动切换真实 LLM 调用。
SAIL_LLM_PROVIDER=openai
SAIL_LLM_MODEL_STRONG=gpt-4o
SAIL_LLM_MODEL_FAST=gpt-4o-mini
SAIL_LLM_API_KEY=
SAIL_LLM_BASE_URL=

# 平台
SAIL_API_HOST=0.0.0.0
SAIL_API_PORT=8000
SAIL_LOG_LEVEL=INFO
