# SAIL 环境变量示例。复制为 .env 并修改。

# 基础设施
SAIL_MYSQL_URL=mysql+pymysql://sail:sail@localhost:3306/sail
SAIL_REDIS_URL=redis://localhost:6379/0
SAIL_MINIO_ENDPOINT=localhost:9000
SAIL_MINIO_ACCESS_KEY=sail
SAIL_MINIO_SECRET_KEY=sail123456
SAIL_MINIO_BUCKET=sail

# CodeQL
SAIL_CODEQL_CLI_PATH=codeql
SAIL_WORKSPACE_ROOT=/tmp/sail-workspaces

# LLM
SAIL_LLM_PROVIDER=openai
SAIL_LLM_MODEL_STRONG=gpt-4o
SAIL_LLM_MODEL_FAST=gpt-4o-mini
SAIL_LLM_API_KEY=
SAIL_LLM_BASE_URL=

# 平台
SAIL_API_HOST=0.0.0.0
SAIL_API_PORT=8000
SAIL_LOG_LEVEL=INFO
