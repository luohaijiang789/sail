# SAIL Docker 环境变量模板。
# 复制为 .env 并修改，docker-compose 自动读取 .env。
# 注意：.env 不进 git（已在 .gitignore 中）。

# === CodeQL 版本 ===
CODEQL_VERSION=2.22.4

# === MySQL ===
MYSQL_ROOT_PASSWORD=sailroot
MYSQL_DATABASE=sail
MYSQL_USER=sail
MYSQL_PASSWORD=sail

# === MinIO ===
MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=sail123456

# === LLM（必填，否则 AI 分析阶段跳过）===
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_STRONG=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# === 日志 ===
LOG_LEVEL=INFO
